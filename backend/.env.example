# ==============================================================================
# VARIABLES DE ENTORNO · SOL DE CASA (BACKEND)
# Copia este archivo a .env y completa los valores correspondientes
# ==============================================================================

# Entorno de ejecución: development | production | test
NODE_ENV=development
PORT=3000

# Origen autorizado de CORS (donde corre el frontend)
CLIENT_URL=http://localhost:5173

# Secreto para firma de cookies de sesión
SESSION_COOKIE_SECRET=sol_de_casa_cookie_secret_cambiar_en_produccion_1234567890

# ------------------------------------------------------------------------------
# CONEXIÓN A BASE DE DATOS MYSQL (mysql2/promise pool)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sol_de_casa_db
DB_CONNECTION_LIMIT=10

# ------------------------------------------------------------------------------
# CUENTA ADMINISTRADORA PREVISTA
# ------------------------------------------------------------------------------
ADMIN_EMAIL=danielramirez272006@gmail.com

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE CORREO SMTP (Transaccional)
# Si no se configuran credenciales, el servidor loguea los tokens y enlaces en consola
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Sol de Casa <no-reply@soldecasa.com>

# ------------------------------------------------------------------------------
# INTEGRACIÓN PLATAFORMA FABRICANTE DE INVERSORES / PANELES
# Estado: PENDIENTE DE CREDENCIALES Y API OFICIAL
# ------------------------------------------------------------------------------
SOLAR_MANUFACTURER_API_URL=https://api.fabricante-inversores.com/v1
SOLAR_MANUFACTURER_API_KEY=

